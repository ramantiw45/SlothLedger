# Copy to .env and fill in what you actually have. Every value is optional:
# with nothing set the app runs on the rules floor and a local SQLite file.

# ---- Judgement lane: an open-weight model over an OpenAI-compatible API ----
# The demo uses qwen/qwen3.8-27b served by Groq. Any compatible endpoint works,
# including a local llama.cpp or Ollama server on http://127.0.0.1:11434/v1.
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
MODEL_NAME=qwen/qwen3.8-27b

# The key may also be supplied as GROQ_API_KEY, which is read as a fallback.
# GROQ_API_KEY=

# ---- Storage ----
# Set DATABASE_URL to use Tiger Cloud / TimescaleDB (hypertable + continuous
# aggregate). Leave it unset for a single SQLite file.
# The direct endpoint presents a self-signed chain, so sslmode=require means
# encrypted-but-unverified; use sslmode=verify-full to verify the host.
# DATABASE_URL=postgresql://sloth_app:PASSWORD@HOST:PORT/tsdb?sslmode=require
# LEDGER_DB=ledger.db

# ---- Server ----
# PORT=8787

# ---- Tests ----
# SLOTH_FORCE_RULES=1
